rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teams: one doc per user, doc id == the owner's auth uid. Holds PII (contact
    // email, member names/affiliations), so it is OWNER-READ-ONLY. The registration
    // uniqueness check uses the PII-free /team_names index instead.
    match /teams/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.email_verified == true;
    }

    // Team names: PII-free index (team name + owner uid) for the registration
    // uniqueness check only. Readable by signed-in users; each user writes only
    // their own doc. Real team details stay in /teams (owner-read-only above).
    match /team_names/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.email_verified == true
                   && request.resource.data.ownerUid == request.auth.uid;
    }

    // Submissions: a verified user may create submissions they own, and read only their own.
    // Organizers read ALL submissions via the Firebase console or Admin SDK (those bypass rules).
    // Submissions are immutable from the client (no edit/delete) to preserve integrity.
    match /submissions/{subId} {
      // Open for the ongoing post-challenge leaderboard (the MICCAI 2026 challenge window
      // closed 2026-09-15 04:00 UTC; that deadline condition was lifted on 2026-09-28).
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read:   if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Leaderboard: public, read-only. Organizers populate it from the Admin SDK (bypasses
    // rules) with ONLY the model name, scores and an opaque random group key. Nothing about
    // WHO submitted (name, team, institution, email, uid, email hash) — every field is
    // world-readable. That lives in leaderboard_private / competitor_groups below.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // Private leaderboard data: submitter name/email/institution/team per entry, plus the
    // challenge-era public-split scores. NO client access — organizers use the Admin SDK only.
    match /leaderboard_private/{entryId} {
      allow read, write: if false;
    }

    // Competitor groups: email -> opaque groupKey used for the public "best entry per
    // participant" ranking (merged accounts share a key). Admin SDK only.
    match /competitor_groups/{email} {
      allow read, write: if false;
    }
  }
}
