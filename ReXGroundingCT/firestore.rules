rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teams: one doc per user, doc id == the owner's auth uid. Holds PII (contact
    // email, member names/affiliations), so it is OWNER-READ-ONLY. The registration
    // uniqueness check uses the PII-free /team_names index instead.
    match /teams/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.email_verified == true;
    }

    // Team names: PII-free index (team name + owner uid) for the registration
    // uniqueness check only. Readable by signed-in users; each user writes only
    // their own doc. Real team details stay in /teams (owner-read-only above).
    match /team_names/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.email_verified == true
                   && request.resource.data.ownerUid == request.auth.uid;
    }

    // Submissions: a verified user may create submissions they own, and read only their own.
    // Organizers read ALL submissions via the Firebase console or Admin SDK (those bypass rules).
    // Submissions are immutable from the client (no edit/delete) to preserve integrity.
    match /submissions/{subId} {
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read:   if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Leaderboard: public, read-only. Organizers populate it from the Firebase
    // console / Admin SDK (those bypass rules) with ONLY public-safe fields
    // (team, submitter name, institution, public-split scores). NEVER write emails
    // or withheld full-set scores here — every field is world-readable.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // Private leaderboard data: withheld full-set scores (for the MICCAI reveal) and
    // submitter emails. NO client access — organizers read via the Admin SDK only.
    match /leaderboard_private/{entryId} {
      allow read, write: if false;
    }
  }
}
